parameters:
    level: 0
    paths:
        - core/src
    excludePaths:
        - core/src/Legacy
    bootstrapFiles:
        - core/bootstrap.php
        - core/includes/aliases.inc.php
        - core/includes/legacy.inc.php
    scanFiles:
        - core/includes/worker.runtime.php
        - core/tests/phpstan/stask-symbols.php
