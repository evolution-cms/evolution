<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "(?i)\.(jpe?g|png|gif|webp|avif|bmp|ico)$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "(?i)\.(jpe?g|png|gif|webp|avif|bmp|ico)$">
        Order deny,allow
        Allow from all
    </FilesMatch>
</IfModule>
