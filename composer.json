  "config": {
    "bin-compat": "full",
    "vendor-dir": "vendor"
  },
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-readline": "*",
    "ext-zip": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "analyze": "@php -d xdebug.mode=off vendor/bin/phpstan --memory-limit=512M"
  }
}
