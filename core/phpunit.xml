<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Test Suite">
            <directory suffix="Test.php">./tests</directory>
            <!-- Plain PHP scripts with their own stubs; StandaloneScriptsTest runs each in its own process. -->
            <exclude>./tests/standalone</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>factory</directory>
            <directory>functions</directory>
            <directory>includes</directory>
            <directory>modifiers</directory>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
